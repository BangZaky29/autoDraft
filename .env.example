# ==============================================================================
# AUTOMINUTA STUDIO - ENVIRONMENT TEMPLATE
# Salin file ini menjadi `.env` lalu isi dengan kredensial project Anda
# ==============================================================================

# Supabase Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Environment Mode: 'development' | 'production'
VITE_APP_ENV=development

# Toggle Bar Dev Auto-Fill (true = Muncul di dev lokal, false = Sembunyikan untuk rilis/production)
VITE_ENABLE_DEV_AUTOFILL=true

